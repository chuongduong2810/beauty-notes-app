# Copy to .env.local and fill in. Never commit .env.local.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Billing (ADR-0023). Set to "true" only once the Stripe Edge Functions are
# deployed + configured (see supabase/functions/README.md); otherwise the app
# uses the in-process mock checkout. Client-safe flag — NOT a secret.
VITE_STRIPE_ENABLED=false
# Stripe publishable key — required for the in-app Embedded Checkout modal
# when VITE_STRIPE_ENABLED=true. Publishable (pk_*), not a secret.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
